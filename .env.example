# Telegram Bot
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID Telegram kamu (angka, cek via @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# Password untuk login ke /admin
ADMIN_PASSWORD=password_rahasia_kamu

# Secret key untuk session cookie admin (string random panjang)
ADMIN_SECRET_KEY=secret_random_string_32_karakter

# Upstash Redis — dapatkan dari https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — khusus untuk Customer Support Chat realtime (bukan data bisnis)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
